# Gradle のビルド成果物とキャッシュ
build/
.gradle/
# gradle-wrapper.jar はコミットする必要があるので除外しない
!gradle/wrapper/gradle-wrapper.jar

# IDE の設定ファイル
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Claude Code のローカル設定
.claude/

# Terraform
# .terraform/ はプロバイダのダウンロード先、tfstate は AWS 上のリソースの記録（ID などを含むので公開しない）
# （terraform/ と terraform-ecs/ の両方に当てはまるように、フォルダ名を指定しない書き方にしている）
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# .terraform.lock.hcl（プロバイダのバージョン固定）はコミットする

# 学習のまとめメモ（ローカル用、リポジトリには含めない）
wrapup-*.md
